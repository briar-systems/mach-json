# the streaming emitter: objects and arrays written one per line

use json.escape.ESCAPE_ENSURE_ASCII;
use json.escape.escape_unit;
use json.stream.Emit;
use json.stream.put_byte;
use json.stream.put_f64;
use json.stream.put_i64;
use json.stream.put_str;
use std.io.writer;
use std.io.writer.WriteError;
use std.system.capability;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.error.err;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;

# an open JSON object in the streaming NDJSON emitter, tracking the comma
# boundary between its members.
# ---
# w:     the writer the object is emitted through (borrowed)
# first: no member has been emitted into the object yet
pub rec Object {
    w:     *writer.Writer;
    first: bool;
}

# an open JSON array in the streaming NDJSON emitter, tracking the comma
# boundary between its elements.
# ---
# w:     the writer the array is emitted through (borrowed)
# first: no element has been emitted into the array yet
pub rec Array {
    w:     *writer.Writer;
    first: bool;
}

# begin a JSON object, writing `{` and arming the first-member
# state.
# ---
# w:   the writer to emit through (must outlive the object)
# o:   the object state to initialise
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_begin(w: *writer.Writer, o: *Object) err[WriteError] {
    o.w     = w;
    o.first = true;
    var e: Emit = Emit{w: w, total: 0};
    ret put_byte(?e, '{');
}

# end a JSON object, writing `}` and the newline that terminates the
# NDJSON line.
# ---
# o:   the object to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_end(o: *Object) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    ret put_str(?e, "}\n");
}

# close a nested object, writing `}` without the NDJSON line
# terminator.
#
# Used for an object that is a member value or an array element, where the
# enclosing container - not this object - owns the line boundary.
# ---
# o:   the object to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun object_end_value(o: *Object) err[WriteError] {
    var e: Emit = Emit{w: o.w, total: 0};
    ret put_byte(?e, '}');
}

# open an object-valued member: the key lead-in, then `{`,
# arming `child` over the parent's writer.
#
# Fill `child` with the field_* helpers and close it with object_end_value; the
# parent stays open and takes further members afterwards.
# ---
# o:     the open parent object
# key:   the member key
# child: the nested object state to initialise
# ret:   ok, or the writer's failure with the persisted prefix
pub fun field_object_begin(o: *Object, key: *u8, child: *Object) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    child.w     = o.w;
    child.first = true;
    ret put_byte(?e, '{');
}

# open an array-valued member: the key lead-in, then `[`,
# arming `arr` over the parent's writer. Close it with array_end.
# ---
# o:   the open parent object
# key: the member key
# arr: the array state to initialise
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_array_begin(o: *Object, key: *u8, arr: *Array) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    arr.w     = o.w;
    arr.first = true;
    ret put_byte(?e, '[');
}

# close an array, writing `]`
# ---
# arr: the array to close
# ret: ok, or the writer's failure with the persisted prefix
pub fun array_end(arr: *Array) err[WriteError] {
    var e: Emit = Emit{w: arr.w, total: 0};
    ret put_byte(?e, ']');
}

# open an object element of `arr`: the element separator,
# then `{`, arming `child` over the array's writer.
#
# Fill `child` with the field_* helpers and close it with object_end_value.
# ---
# arr:   the open array
# child: the element object state to initialise
# ret:   ok, or the writer's failure with the persisted prefix
pub fun array_object_begin(arr: *Array, child: *Object) err[WriteError] {
    var e: Emit = Emit{w: arr.w, total: 0};
    if (!arr.first) {
        val sep: err[WriteError] = put_byte(?e, ',');
        if (sel sep.err) { ret sep; }
    }
    arr.first   = false;
    child.w     = arr.w;
    child.first = true;
    ret put_byte(?e, '{');
}

# emit a string-valued member (the value quoted and ASCII-escaped)
# ---
# o:   the open object
# key: the member key (ASCII, emitted verbatim between quotes)
# v:   the null-terminated value, escaped; nil emits an empty string
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_str(o: *Object, key: *u8, v: *u8) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret json_string(?e, v);
}

# emit a string-or-null member: the escaped value, or JSON
# `null` when `v` is nil.
# ---
# o:   the open object
# key: the member key
# v:   the null-terminated value, or nil for a JSON null
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_str_or_null(o: *Object, key: *u8, v: *u8) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    if (v == nil)     { ret put_str(?e, "null"); }
    ret json_string(?e, v);
}

# emit a JSON `null`-valued member
# ---
# o:   the open object
# key: the member key
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_null(o: *Object, key: *u8) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_str(?e, "null");
}

# emit an integer-valued member
# ---
# o:   the open object
# key: the member key
# v:   the integer value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_i64(o: *Object, key: *u8, v: i64) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_i64(?e, v);
}

# emit a float-valued member
#
# the value is written as the shortest decimal that round-trips through the
# parser (value_float). an integer-valued float emits without a fractional part,
# so the parser reads it back as an integer number (value_is_float false); read
# it with value_number in that case.
# ---
# o:   the open object
# key: the member key
# v:   the float value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_f64(o: *Object, key: *u8, v: f64) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    ret put_f64(?e, v);
}

# emit a boolean-valued member
# ---
# o:   the open object
# key: the member key
# v:   the boolean value
# ret: ok, or the writer's failure with the persisted prefix
pub fun field_bool(o: *Object, key: *u8, v: bool) err[WriteError] {
    var e:    Emit            = Emit{w: o.w, total: 0};
    val lead: err[WriteError] = member(?e, o, key);
    if (sel lead.err) { ret lead; }
    if (v)            { ret put_str(?e, "true"); }
    ret put_str(?e, "false");
}

# write a bare JSON float number through the writer
#
# emits the shortest decimal that round-trips through the parser (value_float),
# with no key or surrounding container - the value equivalent of
# write_json_string for a float, for use as an array element or standalone
# value. an integer-valued float emits without a fractional part.
# ---
# w:   the writer to emit through
# v:   the float value
# ret: ok, or the writer's failure with the persisted prefix
pub fun value_f64(w: *writer.Writer, v: f64) err[WriteError] {
    var e: Emit = Emit{w: w, total: 0};
    ret put_f64(?e, v);
}

# write a JSON string literal under ESCAPE_ENSURE_ASCII: the
# value quoted, every byte escaped to printable ASCII.
# ---
# w:   the writer to emit through
# s:   the null-terminated value, or nil for an empty string
# ret: ok, or the writer's failure with the persisted prefix
pub fun write_json_string(w: *writer.Writer, s: *u8) err[WriteError] {
    var e: Emit = Emit{w: w, total: 0};
    ret json_string(?e, s);
}

fun json_string(e: *Emit, s: *u8) err[WriteError] {
    val open: err[WriteError] = put_byte(e, '"');
    if (sel open.err) { ret open; }
    if (s != nil) {
        var i: usize = 0;
        for (s[i] != 0) {
            val r: res[usize, WriteError] = escape_unit(e, ESCAPE_ENSURE_ASCII, s, i);
            if (sel r.err) { ret err[WriteError].err{r.err}; }
            i = r.ok;
        }
    }
    ret put_byte(e, '"');
}

# write the key/colon lead-in of a member, prefixing a comma after the first
# ---
# e:   the emission to write through
# o:   the open object
# key: the member key (ASCII, emitted verbatim)
fun member(e: *Emit, o: *Object, key: *u8) err[WriteError] {
    if (!o.first) {
        val sep: err[WriteError] = put_byte(e, ',');
        if (sel sep.err) { ret sep; }
    }
    o.first = false;
    val q1: err[WriteError] = put_byte(e, '"');
    if (sel q1.err) { ret q1; }
    val k: err[WriteError] = put_str(e, key::str);
    if (sel k.err) { ret k; }
    ret put_str(e, "\":");
}

$if (capability.HOSTED) {
    #[testing]
    use json.buffer.bytes_are;
    #[testing]
    use json.error.JsonError;
    #[testing]
    use json.parse.parse;
    #[testing]
    use json.value.NUMBER;
    #[testing]
    use json.value.Value;
    #[testing]
    use json.value.make_array;
    #[testing]
    use json.value.make_number;
    #[testing]
    use json.value.value_float;
    #[testing]
    use json.value.value_is_float;
    #[testing]
    use json.value.value_number;
    #[testing]
    use json.write.write_value;
    use std.allocator;
    use std.allocator.page;
    use io_error: std.io.error;

    # a fixed-capacity byte sink used to capture streaming emitter output in tests
    # ---
    # buf: destination buffer
    # cap: buffer capacity
    # len: bytes written so far
    rec TestSink {
        buf: *u8;
        cap: usize;
        len: usize;
    }

    # writer callback appending to a TestSink, dropping bytes past its capacity
    #[testing]
    fun test_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
        val s: *TestSink = ctx::*TestSink;
        var i: usize     = 0;
        for (i < len && s.len < s.cap) {
            s.buf[s.len] = buf[i];
            s.len        = s.len + 1;
            i            = i + 1;
        }
        ret res[usize, WriteError].ok{len};
    }

    # whether the sink's captured bytes equal the nul-terminated want
    #[testing]
    fun sink_is(s: *TestSink, want: *u8) bool {
        ret bytes_are(s.buf, s.len, want);
    }

    # wire a Writer over a TestSink backed by `buf`
    #[testing]
    fun test_writer(w: *writer.Writer, s: *TestSink, buf: *u8, cap: usize) {
        s.buf     = buf;
        s.cap     = cap;
        s.len     = 0;
        w.ctx     = s::ptr;
        w.f_write = test_sink_write;
    }

    # whether write_json_string renders the nul-terminated input as want
    #[testing]
    fun writes_json_string(input: *u8, want: *u8) bool {
        var out:  [64]u8;
        var sink: TestSink;
        var w:    writer.Writer;
        test_writer(?w, ?sink, ?out[0], 64);
        write_json_string(?w, input);
        ret sink_is(?sink, want);
    }

    # ascii passes verbatim, structural and control bytes take their escapes,
    # and utf-8 decodes to \u escapes, astral code points as a surrogate pair
    test write_json_string__escapes {
        if (!writes_json_string("mach.cli.json", "\"mach.cli.json\"")) { ret 1; }
        if (!writes_json_string("x\"\\y", "\"x\\\"\\\\y\""))           { ret 2; }
        var ctl: [3]u8 = [3]u8{0x0a, 0x01, 0};
        if (!writes_json_string(?ctl[0], "\"\\n\\u0001\"")) { ret 3; }
        var bmp: [3]u8 = [3]u8{0xC3, 0xA9, 0};
        if (!writes_json_string(?bmp[0], "\"\\u00e9\"")) { ret 4; }
        var astral: [5]u8 = [5]u8{0xF0, 0x9F, 0x98, 0x80, 0};
        if (!writes_json_string(?astral[0], "\"\\ud83d\\ude00\"")) { ret 5; }
        ret 0;
    }

    # invalid utf-8 emits one U+FFFD escape per byte it resyncs over, never a
    # lone surrogate or an out-of-range code point
    test write_json_string__replaces_invalid_utf8 {
        val fffd2: *u8 = "\"\\ufffd\\ufffd\"";
        val fffd3: *u8 = "\"\\ufffd\\ufffd\\ufffd\"";
        # a cesu-8 surrogate, U+D800
        var surrogate: [4]u8 = [4]u8{0xED, 0xA0, 0x80, 0};
        if (!writes_json_string(?surrogate[0], fffd3)) { ret 1; }
        # an overlong nul
        var overlong: [3]u8 = [3]u8{0xC0, 0x80, 0};
        if (!writes_json_string(?overlong[0], fffd2)) { ret 2; }
        # a lead byte past 0xF4
        var lead: [2]u8 = [2]u8{0xF5, 0};
        if (!writes_json_string(?lead[0], "\"\\ufffd\"")) { ret 3; }
        # U+110000, past the last code point
        var above: [5]u8 = [5]u8{0xF4, 0x90, 0x80, 0x80, 0};
        if (!writes_json_string(?above[0], "\"\\ufffd\\ufffd\\ufffd\\ufffd\"")) { ret 4; }
        # a three-byte sequence cut short
        var cut: [3]u8 = [3]u8{0xE2, 0x82, 0};
        if (!writes_json_string(?cut[0], fffd2)) { ret 5; }
        ret 0;
    }

    # the ndjson object builder renders every field kind, nested objects and
    # arrays, empty arrays included, as one newline-terminated line
    test json__ndjson_object_exact_bytes {
        var out:  [160]u8;
        var sink: TestSink;
        var w:    writer.Writer;
        test_writer(?w, ?sink, ?out[0], 160);

        var root: Object;
        object_begin(?w, ?root);
        field_i64(?root, "n", 7);
        field_str(?root, "s", "a\"b");
        field_bool(?root, "b", true);
        field_str_or_null(?root, "o", nil);
        field_null(?root, "z");

        var loc: Object;
        field_object_begin(?root, "loc", ?loc);
        field_i64(?loc, "line", 2);
        field_i64(?loc, "col", 3);
        object_end_value(?loc);

        var rel: Array;
        field_array_begin(?root, "rel", ?rel);
        var e0: Object;
        array_object_begin(?rel, ?e0);
        field_str(?e0, "label", "x");
        object_end_value(?e0);
        var e1: Object;
        array_object_begin(?rel, ?e1);
        field_str(?e1, "label", "y");
        object_end_value(?e1);
        array_end(?rel);

        var none: Array;
        field_array_begin(?root, "none", ?none);
        array_end(?none);
        object_end(?root);

        val want: *u8 = "{\"n\":7,\"s\":\"a\\\"b\",\"b\":true,\"o\":null,\"z\":null,\"loc\":{\"line\":2,\"col\":3},\"rel\":[{\"label\":\"x\"},{\"label\":\"y\"}],\"none\":[]}\n";
        if (!sink_is(?sink, want)) { ret 1; }
        ret 0;
    }

    # emit v through value_f64, parse it back, and report whether the recovered
    # number equals v. an integer-valued float emits with no fractional part and
    # parses as an integer number, so the read-back selects value_number there.
    #[testing]
    fun f64_round_trips(v: f64) bool {
        var out:  [48]u8;
        var sink: TestSink;
        var w:    writer.Writer;
        test_writer(?w, ?sink, ?out[0], 48);
        value_f64(?w, v);

        var a: allocator.Allocator;
        page.make(?a);
        val r: res[Value, JsonError] = parse(sink.buf, sink.len, ?a);
        if (sel r.err) { ret false; }
        val pv: Value = r.ok;
        if (pv.kind != NUMBER) { ret false; }
        var got: f64 = 0.0;
        if (value_is_float(?pv)) { got = value_float(?pv); }
        or                       { got = value_number(?pv)::f64; }
        ret got == v;
    }

    # value_f64 emits a decimal the parser reads back to the same f64 across
    # fractional, negative, and integer-valued spreads.
    test json__value_f64_round_trips {
        if (!f64_round_trips(21.5))      { ret 1; }
        if (!f64_round_trips(-21.5))     { ret 1; }
        if (!f64_round_trips(3.0))       { ret 1; }
        if (!f64_round_trips(-7.0))      { ret 1; }
        if (!f64_round_trips(0.125))     { ret 1; }
        if (!f64_round_trips(1234.5678)) { ret 1; }
        ret 0;
    }

    # a sink that persists `cap` bytes and then fails natively
    #[testing]
    rec FailSink {
        buf: *u8;
        cap: usize;
        len: usize;
    }

    #[testing]
    fun fail_sink_write(ctx: ptr, buf: *u8, len: usize) res[usize, WriteError] {
        val s: *FailSink = ctx::*FailSink;
        var i: usize     = 0;
        for (i < len) {
            if (s.len >= s.cap) {
                ret res[usize, WriteError].err{writer.native_failure(i, io_error.make(io_error.RESOURCE_EXHAUSTED, io_error.OP_WRITE))};
            }
            s.buf[s.len] = buf[i];
            s.len        = s.len + 1;
            i            = i + 1;
        }
        ret res[usize, WriteError].ok{len};
    }

    # every streaming helper reports the bytes it persisted before the sink
    # failed, however many writes deep the failure was
    test json__streaming_failure_carries_prefix {
        var out: [64]u8;
        var s:   FailSink;
        s.buf = ?out[0];
        s.cap = 12;
        s.len = 0;
        var w: writer.Writer;
        w.ctx     = (?s)::ptr;
        w.f_write = fail_sink_write;

        var o:     Object;
        val began: err[WriteError] = object_begin(?w, ?o);
        if (sel began.err) { ret 1; }
        val first: err[WriteError] = field_i64(?o, "n", 7);
        if (sel first.err) { ret 2; }
        # `{"n":7` is 6 bytes; `,"s":"a\"b"` needs 11 and the sink takes 6 more
        val second: err[WriteError] = field_str(?o, "s", "a\"b");
        if (!sel second.err)                   { ret 3; }
        if (!sel second.err.native)            { ret 4; }
        if (writer.persisted(second.err) != 6) { ret 5; }
        if (s.len != 12)                       { ret 6; }
        if (out[6] != ',' || out[11] != '"')   { ret 7; }

        # a tree emission through write_value reports the same way
        s.len = 0;
        s.cap = 3;
        var arr:   Value = make_array();
        var items: [2]Value;
        items[0]     = make_number(12);
        items[1]     = make_number(34);
        arr.children = ?items[0];
        arr.count    = 2;
        val tree: err[WriteError] = write_value(?w, ?arr);
        if (!sel tree.err)                                   { ret 8; }
        if (writer.persisted(tree.err) != 3)                 { ret 9; }
        if (out[0] != '[' || out[1] != '1' || out[2] != '2') { ret 10; }
        ret 0;
    }
}
